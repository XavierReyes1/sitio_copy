{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SpendAudit",
    "Audience": "SpendAudit.Clientes",
    "ExpirationMinutes": 480
  },
  "Storage": {
    "RootPath": "uploads"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Docs": {
    "Enabled": false
  }
}
